{
  "name": "nb-sound",
  "version": "2.0.0-alpha.0",
  "description": "Aplicación de escritorio para la música local: reproducir, catalogar, karaoke y DJ",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Nate-1296/NB-SOUND.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check . && prettier --check \"**/*.{svelte,css}\"",
    "lint:fix": "biome check --write . && prettier --write \"**/*.{svelte,css}\"",
    "format": "biome format --write . && prettier --write \"**/*.{svelte,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm guardianes",
    "guardianes": "node scripts/guardianes.mjs",
    "paletas": "node scripts/generar-paletas.mjs",
    "check:paletas": "node scripts/generar-paletas.mjs --check",
    "temas": "node scripts/generar-temas.mjs",
    "binarios": "node scripts/fetch-binarios.mjs",
    "check:binarios": "node scripts/fetch-binarios.mjs --check"
  },
  "dependencies": {
    "@ktibow/material-color-utilities-nightly": "0.4.01772748028000",
    "@tauri-apps/api": "^2.11.1",
    "m3-svelte": "^7.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.1",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
