{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NB Sound",
  "mainBinaryName": "nb-sound",
  "version": "2.0.0-alpha.0",
  "identifier": "org.nbsound.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NB Sound",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost portada: http://portada.localhost blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Tu música local, catalogada y lista para sonar",
    "longDescription": "NB Sound reproduce, cataloga e identifica tu música local, completa portadas y letras, prepara karaoke y mezcla sesiones de DJ. Sin conexión por defecto y con todo dentro del instalador.",
    "copyright": "Copyright 2026 The NB Sound Authors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RDkwQTgyMzREQjM4QTcKUldTbk9OczBnZ3JaVmRhV1VqM1VjQXVmOGZxOFBMZk5zemV0Ums4WXBYMWlyM2x6TUt0Qk5ocy8K",
      "endpoints": ["https://github.com/Nate-1296/NB-SOUND/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
