# ---------------------------------------------------------------------------
# NB Sound
# Regla: en el repositorio solo entra código fuente y documentación.
# Nada generado, nada descargado, nada secreto, ningún binario precompilado.
# La V1 congelada tiene su propio .gitignore en legado/.
# ---------------------------------------------------------------------------

# Node / pnpm
node_modules/
.pnpm-store/
*.tsbuildinfo

# SvelteKit / Vite
.svelte-kit/
.svelte-kit-e2e/
/build/
/build-e2e/
/package/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust / Cargo / Tauri
target/
**/*.rs.bk
src-tauri/gen/

# Binarios externos (ffmpeg, fpcalc, ONNX Runtime): se obtienen con hash fijado
# con scripts/fetch-binarios.mjs y nunca se versionan (ADR-006).
src-tauri/binarios/
src-tauri/vendor/
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib

# Artefactos de distribución
dist/
*.AppImage
*.deb
*.rpm
*.dmg
*.msi
*.exe

# Modelos: son agregados que se descargan desde la aplicación (ADR-006)
*.onnx
*.pb
models/

# Ajustes personales de la herramienta agéntica
.claude/settings.local.json

# Secretos y entorno
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
secrets/

# Bases de datos y datos locales de desarrollo
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# Resultados de pruebas y cobertura
coverage/
test-results/
playwright-report/

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.directory
